{
  "name": "blinkblink",
  "version": "0.2.3",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build:dev && electron .",
    "build:dev": "cross-env NODE_ENV=development webpack --config webpack.config.js",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headless": "npm run build && xvfb-run -a --server-args=\"-screen 0 1600x1000x24\" playwright test"
  },
  "build": {
    "appId": "blinkblink",
    "productName": "BlinkBlink",
    "copyright": "Copyright © 2024-2026 Wei-Cheng Huang",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.{map,ts,tsx}",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme,LICENSE,LICENSE.txt,NOTICE}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples,doc,docs}",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "assets/sounds",
        "to": "assets/sounds",
        "filter": [
          "**/*.opus"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "frozen0601",
        "repo": "BlinkBlink-Releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlinkBlink",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.healthcare-fitness",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSUserNotificationAlertStyle": "alert"
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Utility;Health",
      "synopsis": "Healthy Eyes, Happy Life",
      "description": "BlinkBlink reminds you to follow the 20-20-20 rule: every 20 minutes, look at something 20 feet away for 20 seconds.",
      "desktop": {
        "Name": "BlinkBlink",
        "StartupWMClass": "blinkblink"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "plugs": [
        "default"
      ]
    }
  },
  "homepage": "https://blinkblinkapp.github.io/",
  "keywords": [
    "202020",
    "20-20-20",
    "vision",
    "eye health",
    "productivity",
    "break reminder",
    "desktop app",
    "health",
    "wellness",
    "well-being"
  ],
  "author": {
    "name": "Wei-Cheng Huang",
    "email": "andywh1996@gmail.com"
  },
  "license": "UNLICENSED",
  "description": "Healthy Eyes, Happy Life",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.12.0",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^10.1.0",
    "electron": "^38.4.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "electron-dl": "^4.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  }
}
