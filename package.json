{
    "name": "blinkblink",
    "version": "0.0.6-alpha",
    "main": "dist/main.js",
    "scripts": {
        "start": "cross-env NODE_ENV=development webpack --config webpack.config.js && electron .",
        "build": "cross-env NODE_ENV=production webpack --config webpack.config.js",
        "dist": "npm run build && electron-builder"
    },
    "build": {
        "appId": "blinkblink",
        "productName": "BlinkBlink",
        "files": [
            "dist/**/*",
            "node_modules/**/*",
            "package.json",
            "assets/**/*",
            "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
            "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
            "!**/node_modules/.bin",
            "!**/*.{map,ts}"
        ],
        "extraResources": [
            {
                "from": "assets/",
                "to": "assets/",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "publish": {
            "provider": "github",
            "owner": "frozen0601",
            "repo": "BlinkBlink-Releases"
        },
        "win": {
            "appId": "blinkblink",
            "target": "nsis",
            "icon": "assets/icon.ico",
            "artifactName": "${productName}.Setup.${version}.${ext}"
        },
        "mac": {
            "appId": "blinkblink",
            "target": "dmg",
            "icon": "assets/icon.icns",
            "artifactName": "${productName}.Setup.${version}.${ext}"
        },
        "linux": {
            "target": "AppImage",
            "icon": "assets/icon.png",
            "artifactName": "${productName}.Setup.${version}.${ext}"
        }
    },
    "homepage": "https://github.com/frozen0601/BlinkBlink-Releases",
    "keywords": [
        "202020",
        "20-20-20",
        "vision",
        "eye health",
        "productivity",
        "break reminder",
        "desktop app",
        "health",
        "wellness",
        "well-being"
    ],
    "author": "Wei-Cheng Huang",
    "license": "Proprietary",
    "description": "Healthy Eyes, Happy Life",
    "devDependencies": {
        "@types/electron": "^1.4.38",
        "@types/node": "^22.9.0",
        "@types/node-fetch": "^2.6.12",
        "@types/semver": "^7.5.8",
        "copy-webpack-plugin": "^12.0.2",
        "cross-env": "^7.0.3",
        "electron": "^33.1.0",
        "electron-builder": "^25.1.8",
        "ts-loader": "^9.5.1",
        "typescript": "^5.6.3",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "date-fns": "^4.1.0",
        "electron-dl": "^4.0.0",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.3.9",
        "node-fetch": "^3.3.2",
        "semver": "^7.6.3"
    }
}
