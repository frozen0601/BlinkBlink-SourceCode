{
    "name": "blinkblink",
    "version": "1.0.0",
    "main": "dist/main.js",
    "scripts": {
        "start": "webpack && electron .",
        "build": "webpack",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "com.frozen.blinkblink",
        "productName": "BlinkBlink",
        "files": [
            "dist/**/*",
            "node_modules/**/*",
            "package.json",
            "assets/**/*"
        ],
        "directories": {
            "buildResources": "build",
            "output": "release"
        },
        "win": {
            "target": "nsis"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "keywords": [
        "202020",
        "20-20-20",
        "vision",
        "eye health",
        "productivity",
        "break reminder",
        "desktop app",
        "health",
        "wellness",
        "well-being"
    ],
    "author": "Wei-Cheng Huang",
    "license": "Proprietary",
    "description": "BlinkBlink is a desktop app that reminds you to follow the 20-20-20 rule, helping protect your eyes and boost productivity with regular break reminders.",
    "devDependencies": {
        "@types/electron": "^1.4.38",
        "@types/node": "^22.9.0",
        "copy-webpack-plugin": "^12.0.2",
        "electron": "^33.1.0",
        "electron-builder": "^25.1.8",
        "ts-loader": "^9.5.1",
        "typescript": "^5.6.3",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "date-fns": "^4.1.0",
        "electron-store": "^8.2.0"
    }
}
